# Supabase (create a new project; keep it separate from other apps)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Server / scripts only. Never expose to the browser.
# Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# Optional: overrides NEXT_PUBLIC_SUPABASE_URL for scripts
# SUPABASE_URL=https://<your-project-ref>.supabase.co

# LLM extraction (Phase 3)
ANTHROPIC_API_KEY=<anthropic-api-key>
